# Install privately at /opt/sitepulse-staging/shared/.env (mode 600).
# Production uses /opt/sitepulse-production/shared/.env; use independent secrets.
NODE_ENV=production
APP_ORIGIN=https://staging.sitepulse.example.com
POSTGRES_USER=sitepulse
POSTGRES_DB=sitepulse
# Generate two independent base64url values. Never reuse Windows local credentials.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
AUTH_MAIL_TRANSPORT=resend
AUTH_MAIL_FROM=
RESEND_API_KEY=
LOG_LEVEL=info
HEARTBEAT_STALE_SECONDS=2700
WORKER_POLL_SECONDS=60
