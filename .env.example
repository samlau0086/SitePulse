# Copy to .env. Never commit .env. Generate independent random values for both secrets.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
LOG_LEVEL=info
BETTER_AUTH_SECRET=
AUTH_MAIL_TRANSPORT=file
AUTH_MAIL_FROM=no-reply@localhost.test
# Production: AUTH_MAIL_TRANSPORT=resend, a verified sender, and provider API key.
# RESEND_API_KEY=
# Optional Bark support: generate 32 random bytes as 64 lowercase hex characters.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BARK_ENCRYPTION_KEY=
# Optional Slack/Telegram AES-256-GCM key: generate 32 random bytes as 64 hex characters. Keep stable.
NOTIFICATION_ENCRYPTION_KEY=
POSTGRES_USER=sitepulse
POSTGRES_DB=sitepulse
POSTGRES_PASSWORD=
# For host development, replace YOUR_ENCODED_PASSWORD with the URL-encoded DB password.
DATABASE_URL=postgresql://sitepulse:YOUR_ENCODED_PASSWORD@127.0.0.1:5432/sitepulse
# Dedicated disposable test DB; test suite refuses names not ending in _test.
TEST_DATABASE_URL=postgresql://sitepulse_test:sitepulse_test@127.0.0.1:5433/sitepulse_test
HEARTBEAT_STALE_SECONDS=2700
WORKER_POLL_SECONDS=60
MONITORING_ENABLED=true
# Global HTTP probe interval: 60–3600 seconds (1–60 minutes), default 300.
MONITOR_INTERVAL_SECONDS=300
SSL_INTERVAL_SECONDS=86400
# Verified Better Auth user UUIDs, comma-separated. Empty disables platform administration.
PLATFORM_ADMIN_USER_IDS=
