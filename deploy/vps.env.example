# Reference only: Actions generates shared/.env from GitHub Environment settings.
# No manual VPS file creation is needed. See docs/GITHUB_ACTIONS_VPS.md.
# Production uses its own GitHub Environment; use independent stable secrets.
NODE_ENV=production
APP_ORIGIN=https://staging.sitepulse.example.com
POSTGRES_USER=sitepulse
POSTGRES_DB=sitepulse
# Generate two independent base64url values. Never reuse Windows local credentials.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Required for new Drive attachment uploads; configure both as GitHub Environment secrets.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
AUTH_MAIL_TRANSPORT=resend
AUTH_MAIL_FROM=
RESEND_API_KEY=
# Stable 64-character hex key used to encrypt Bark device keys at rest.
BARK_ENCRYPTION_KEY=
# Optional Slack/Telegram encryption key (64 hex characters); keep stable and back up securely.
NOTIFICATION_ENCRYPTION_KEY=
LOG_LEVEL=info
HEARTBEAT_STALE_SECONDS=2700
WORKER_POLL_SECONDS=60
MONITORING_ENABLED=true
SECURITY_ADVISORIES_ENABLED=true
MONITOR_INTERVAL_SECONDS=900
SSL_INTERVAL_SECONDS=86400
# Verified Better Auth user UUIDs, comma-separated. Set as a GitHub Environment variable.
PLATFORM_ADMIN_USER_IDS=
## Optional platform-wide Google PageSpeed Insights performance monitoring
PERFORMANCE_ENABLED=false
PAGESPEED_API_KEY=
PERFORMANCE_MAX_DAILY_REQUESTS=500
PERFORMANCE_INTERVAL_SECONDS=86400
